FOCUSFORGE_ENV=development
FOCUSFORGE_DATABASE_URL=sqlite:///./focusforge.db
FOCUSFORGE_JWT_SECRET=replace-with-at-least-32-random-characters
FOCUSFORGE_ACCESS_TOKEN_MINUTES=15
FOCUSFORGE_REFRESH_TOKEN_DAYS=30
FOCUSFORGE_CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1,http://127.0.0.1:3000
FOCUSFORGE_MAX_REQUEST_BYTES=1048576
FOCUSFORGE_MAX_UPLOAD_BYTES=52428800
FOCUSFORGE_BACKUP_DIRECTORY=./backups
FOCUSFORGE_PRODUCTION_API_BASE_URL=
